{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "alias": [
    "live.kiarostudio.com",
    "live.yontuk.com",
    "vote.yontuk.com"
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "live.yontuk.com" }],
      "destination": "https://live.cyberpopstudio.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "vote.yontuk.com" }],
      "destination": "https://vote.cyberpopstudio.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/vote",
      "destination": "/index.html"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
